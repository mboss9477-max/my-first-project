# Names only. Copy to .env (untracked) and fill in locally. Never commit values (AGENTS.md S1, S17).
# Long random string used to sign sessions.
PAYLOAD_SECRET=
# Shared secret for newsletter signups: the website presents it to
# POST /api/newsletter-subscribers/subscribe. Must equal the website's
# CMS_SUBSCRIBE_SECRET. With it unset the endpoint refuses every request.
SUBSCRIBE_SECRET=
# Which database the CMS uses. A postgres:// or postgresql:// address means
# Postgres (staging, production, CI): tables then come only from the committed
# migrations in src/migrations (run `npm run migrate`; AGENTS.md S18).
# Anything else, or unset, means a local SQLite file (file:./cms-trial.db) for
# quick developer runs and tests. Never SQLite in production.
DATABASE_URL=
# Tests only. Set to a Postgres address (any database on a server where you can
# create databases) to run the test suite on Postgres instead of SQLite.
# CI sets this; locally it is optional.
TEST_DATABASE_URL=
# Tell the public website to refresh when content is published. Both must be set
# or nothing is sent (normal on a developer machine). The secret must equal the
# website's REVALIDATE_SECRET. Optional: WEB_REVALIDATE_DELAY_MS (default 1500).
WEB_REVALIDATE_URL=
WEB_REVALIDATE_SECRET=
# The address this CMS is served from, e.g. https://cms.example.com. Only this
# origin may send logged-in requests (CSRF). Defaults to http://localhost:3200.
CMS_URL=
# Migration from Sanity (scripts/migrate-from-sanity.ts). All optional; the default is a dry run.
# MIGRATE_APPLY=1 writes. MIGRATE_CONFIRM_TARGET must then equal the target text the script prints
# (database host and name, never the password). MIGRATE_OVERWRITE=1 replaces existing items.
# MIGRATE_REPORT_FILE saves the report to a file.
MIGRATE_APPLY=
MIGRATE_CONFIRM_TARGET=
MIGRATE_OVERWRITE=
MIGRATE_REPORT_FILE=
