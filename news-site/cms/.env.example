# Names only. Copy to .env (untracked) and fill in locally. Never commit values (AGENTS.md S1, S17).
# Long random string used to sign sessions.
PAYLOAD_SECRET=
# Local trial: a SQLite file. Defaults to file:./cms-trial.db when unset.
DATABASE_URL=
# Tell the public website to refresh when content is published. Both must be set
# or nothing is sent (normal on a developer machine). The secret must equal the
# website's REVALIDATE_SECRET. Optional: WEB_REVALIDATE_DELAY_MS (default 1500).
WEB_REVALIDATE_URL=
WEB_REVALIDATE_SECRET=
# The address this CMS is served from, e.g. https://cms.example.com. Only this
# origin may send logged-in requests (CSRF). Defaults to http://localhost:3200.
CMS_URL=
