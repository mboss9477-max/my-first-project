# Names only. Copy to .env.local (untracked) and fill in locally. Never commit values (AGENTS.md S1, S17).

# Which backend the site reads: "sanity" (default when unset) or "cms" (the new Payload CMS).
CONTENT_SOURCE=
# Where the CMS can be reached by the website's server, e.g. http://localhost:3200 locally.
CMS_URL=
# Optional: the address readers' browsers use for CMS images, if it differs from CMS_URL.
CMS_PUBLIC_URL=

# Shared secret for the publish webhooks (/api/revalidate-cms). Must equal the CMS's WEB_REVALIDATE_SECRET.
REVALIDATE_SECRET=

# Sanity (legacy), only for the features that still use it.
SANITY_VIEWER_TOKEN=
SANITY_WRITE_TOKEN=
SANITY_REVALIDATE_SECRET=
